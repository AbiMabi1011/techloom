generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING    // cart not yet checked out
  RESERVED   // stock reserved, awaiting payment
  PAID       // payment succeeded
  CANCELLED  // cancelled by customer
  EXPIRED    // reservation expired / payment timed out
  FAILED     // payment attempt failed
  REFUNDED   // refund issued after cancellation/failure of a paid order
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  category    String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
}

// One cart per customer/guest session. customerId is a client-generated
// identifier (e.g. UUID stored in localStorage) — no auth system required
// by the brief, but it's enough to key order history and carts per shopper.
model Cart {
  id         Int      @id @default(autoincrement())
  customerId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id                   Int         @id @default(autoincrement())
  customerId           String
  status               OrderStatus @default(PENDING)
  totalAmount          Decimal     @db.Decimal(10, 2) @default(0)
  reservationExpiresAt DateTime?
  idempotencyKey       String      @unique
  refundedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items           OrderItem[]
  paymentAttempts PaymentAttempt[]

  @@index([customerId])
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Int
  priceAtOrder Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model PaymentAttempt {
  id         Int      @id @default(autoincrement())
  orderId    Int
  outcome    String   // SUCCESS | FAILURE | TIMEOUT
  attemptKey String   @unique
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}
